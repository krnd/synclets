{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "version": 3,
    "final_space": true,
    "patch_pwsh_bleed": true,
    "secondary_prompt": {
        "foreground": "#E6E6E6",
        "template": "\u276f "
    },
    "transient_prompt": {
        "foreground": "#666666",
        "foreground_templates": [
            "{{ if gt .Code 0 }}#E45454{{ end }}"
        ],
        "template": "\u276f "
    },
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "session",
                    "style": "powerline",
                    "background": "#68217A",
                    "foreground": "#E6E6E6",
                    "powerline_symbol": "\ue0bc",
                    "template": " {{ if .SSHSession }}\udb81\udca0 {{ end }}{{ .UserName }} ",
                    "properties": {
                        "cache_duration": "none",
                        "display_host": false,
                        "display_user": true
                    }
                },
                {
                    "type": "path",
                    "style": "powerline",
                    "background": "#007ACC",
                    "foreground": "#E6E6E6",
                    "powerline_symbol": "\ue0bc",
                    "template": " {{ .Path }} ",
                    "properties": {
                        "cache_duration": "none",
                        "style": "agnoster_short",
                        "folder_separator_icon": " \ue0bb ",
                        "max_depth": 3,
                        "mapped_locations": {
                            "~/Projects": "\uf0b1"
                        }
                    }
                },
                {
                    "type": "git",
                    "style": "powerline",
                    "foreground": "#1A1A1A",
                    "background": "#0A703E",
                    "background_templates": [
                        "{{ if (or (gt .Behind 0) .Merge .CherryPick .Revert) }}#E45454{{ end }}",
                        "{{ if (or .UpstreamGone .Detached) }}#9E9E9E{{ end }}",
                        "{{ if (or .Working.Changed .Staging.Changed) }}#E29031{{ end }}",
                        "{{ if (gt .Ahead 0) }}#4EC9B0{{ end }}"
                    ],
                    "powerline_symbol": "\ue0bc",
                    "templates": [
                        " {{ .UpstreamIcon }} {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} ",
                        "{{ if .Working.Changed }}\uf044 {{ .Working.String }} {{ end }}",
                        "{{ if (and .Working.Changed .Staging.Changed) }}| {{ end }}",
                        "{{ if .Staging.Changed }}\uf046 {{ .Staging.String }} {{ end }}",
                        "{{ if (gt .StashCount 0) }}\ueb4b {{ .StashCount }} {{ end }}",
                        "{{ if (gt .WorktreeCount 0) }}\uf1bb {{ .WorktreeCount }} {{ end }}"
                    ],
                    "properties": {
                        "cache_duration": "none",
                        "branch_icon": "",
                        "branch_identical_icon": "",
                        "fetch_status": true,
                        "fetch_upstream_icon": true,
                        "fetch_worktree_count": true,
                        "fetch_stash_count": true
                    }
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "right",
            "segments": [
                {
                    "type": "status",
                    "style": "diamond",
                    "background": "#E45454",
                    "foreground": "#1A1A1A",
                    "leading_diamond": "\ue0ba",
                    "trailing_diamond": "\ue0bc",
                    "template": " \uf00d {{ .Code }} ",
                    "properties": {
                        "cache_duration": "none",
                        "always_enabled": false
                    }
                },
                {
                    "type": "python",
                    "style": "diamond",
                    "background": "#333333",
                    "foreground": "#666666",
                    "foreground_templates": [
                        "{{ if .Error }}#B22222{{ end }}",
                        "{{ if .Venv }}#007ACC{{ end }}"
                    ],
                    "leading_diamond": "\ue0ba",
                    "trailing_diamond": "\ue0bc",
                    "template": " \ue235{{ if .Error }} {{ .Error }}{{ end }} ",
                    "properties": {
                        "cache_duration": "none",
                        "display_default": true,
                        "display_error": true,
                        "display_mode": "context",
                        "fetch_version": false,
                        "fetch_virtual_env": true
                    }
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "status",
                    "style": "plain",
                    "foreground": "#E6E6E6",
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}#E45454{{ end }}"
                    ],
                    "template": "\u276f",
                    "properties": {
                        "cache_duration": "none",
                        "always_enabled": true
                    }
                }
            ]
        },
        {
            "type": "rprompt",
            "alignment": "right",
            "segments": [
                {
                    "type": "root",
                    "style": "diamond",
                    "background": "#E45454",
                    "foreground": "#E6E6E6",
                    "leading_diamond": "\ue0ba",
                    "trailing_diamond": "\ue0bc",
                    "template": " \uf0e7 "
                }
            ]
        }
    ]
}
